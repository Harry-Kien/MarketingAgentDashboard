# ============================================================
#  Marketing Agent — cấu hình
#  Copy sang .env rồi điền. KHÔNG commit .env.
# ============================================================

# --- Nhà cung cấp model ---------------------------------------
# vertex    : Claude qua Vertex AI. Cần project ĐÃ ĐƯỢC CẤP QUOTA Claude.
#             Project mới mặc định quota = 0 -> mọi lời gọi trả 429.
# anthropic : Claude qua API trực tiếp. Chỉ cần API key, chạy được ngay.
# Cùng model, cùng giá. Đổi dòng này là đổi đường đi, không sửa mã.
LLM_PROVIDER=vertex
ANTHROPIC_API_KEY=

# --- Google Cloud / Vertex AI ---------------------------------
# Xác thực: chạy `gcloud auth application-default login` trước.
# LƯU Ý: embedding cho RAG luôn dùng Vertex (hạn mức riêng, độc lập
# với quota Claude), nên GCP_PROJECT_ID vẫn cần dù chọn provider nào.
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=global

# Model trên Vertex dùng ID TRẦN, không prefix.
MODEL_CHAT=claude-sonnet-5
MODEL_HARD=claude-opus-5
MODEL_CHEAP=claude-haiku-4-5

# --- ZaloCRM (kênh giai đoạn 1) -------------------------------
# Lấy X-API-Key trong Settings của ZaloCRM sau khi quét QR.
ZALOCRM_BASE_URL=http://localhost:3000
ZALOCRM_API_KEY=
# Webhook ZaloCRM gọi về đây. Trong Docker Desktop trên Windows
# phải dùng host.docker.internal, không dùng localhost.
WEBHOOK_PUBLIC_URL=http://host.docker.internal:8000/webhook
WEBHOOK_SECRET=doi-chuoi-nay-di

# --- Cơ sở dữ liệu --------------------------------------------
DATABASE_URL=postgresql://agent:agent@localhost:5433/marketing_agent

# --- Giọng đọc ------------------------------------------------
# auto    = thử viet-tts trước, không có thì dùng Google Cloud TTS
# viettts | google = ép dùng đúng một nhà cung cấp
TTS_PROVIDER=auto

# viet-tts: phải tự dựng (clone repo, tải model). Miễn phí.
TTS_BASE_URL=http://localhost:8298/v1
TTS_VOICE=nu-nhe-nhang

# Google Cloud TTS: nằm trên chính project GCP ở trên, không cài gì thêm,
# nhưng TÍNH TIỀN THEO KÝ TỰ nên phải bật bằng tay trước:
#   gcloud services enable texttospeech.googleapis.com
GOOGLE_TTS_VOICE=vi-VN-Neural2-A

# --- Video ----------------------------------------------------
VIDEO_STUDIO_DIR=./video-studio
VIDEO_OUTPUT_DIR=./data/videos
FFPROBE_BIN=ffprobe
# Bậc dựng hình cao nhất (ảnh sản phẩm -> cảnh quay có chuyển động).
# ĐỂ RỖNG LÀ TẮT — Veo tính tiền theo giây video sinh ra, không nên để nó
# tự chạy. Bật bằng cách điền tên model, ví dụ: veo-3.1-generate-preview
# Cần xin quota Veo trên GCP trước.
VEO_MODEL=

# Bậc HyperFrames (HTML/CSS -> MP4, bố cục đẹp hơn ffmpeg). TẮT mặc định vì
# chưa dựng được lớp giọng đọc trong composition — bật lên thì video đẹp hơn
# nhưng MẤT TIẾNG. Chỉ bật khi hình quan trọng hơn tiếng.
# Cần chạy một lần: npx hyperframes init video-studio
HYPERFRAMES_BAT=false

# --- Langfuse (trace + chi phí) -------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3001

# --- Vận hành -------------------------------------------------
# Bật/tắt agent tức thì. false = mọi tin nhắn chuyển thẳng cho người.
AGENT_ENABLED=true
# assist  = agent chỉ gợi ý, người bấm gửi (khuyến nghị khi mới chạy)
# auto    = agent tự trả lời
AGENT_MODE=assist
# Ngưỡng tin cậy dưới mức này thì chuyển người.
CONFIDENCE_FLOOR=0.55
# Trần chi phí mỗi hội thoại (USD). Vượt thì chuyển người.
MAX_COST_PER_CONVERSATION=0.25

# --- Phân phối bài lên mạng xã hội ----------------------------
# Đường đi: n8n -> API chính thức -> hàng đợi thủ công.
# Không cấu hình gì thì bài vẫn vào hàng đợi để người đăng tay,
# hệ thống KHÔNG chết vì thiếu quyền nền tảng.

# n8n giữ OAuth Facebook/TikTok. Tạo workflow có Webhook node rồi dán URL.
N8N_WEBHOOK_URL=
N8N_AUTH_HEADER=
# URL n8n / Instagram gọi ngược về được (Docker: host.docker.internal).
PUBLIC_BASE_URL=http://host.docker.internal:8000

# Meta — cần Business Verification + App Review pages_manage_posts (1-4 tuần).
FB_PAGE_ID=
FB_PAGE_TOKEN=
IG_USER_ID=

# TikTok — cần audit Content Posting API. Chưa audit thì PHẢI để SELF_ONLY.
TIKTOK_ACCESS_TOKEN=
TIKTOK_PRIVACY=SELF_ONLY

# Bài đăng luôn phải có người duyệt. Đổi thành true là bỏ chốt an toàn.
TU_DONG_DANG_KHONG_CAN_DUYET=false

# --- Chatwoot (hộp thư đa nền tảng) ---------------------------
# Gom Facebook Messenger, Instagram DM, WhatsApp, chat website, email.
# Khác ZaloCRM: Chatwoot KHÔNG chặn SSRF nên webhook về localhost chạy được.
# Trong Chatwoot: Settings > Integrations > Webhooks, trỏ về
#   http://host.docker.internal:8000/webhook/chatwoot
# và chọn sự kiện message_created.
CHATWOOT_BASE_URL=
CHATWOOT_API_TOKEN=
CHATWOOT_ACCOUNT_ID=

# --- Canh gác -------------------------------------------------
# Hỏi sức khoẻ đều đặn và báo khi trạng thái ĐỔI sang hỏng. Báo mỗi lần
# kiểm thì sau nửa tiếng người ta tắt thông báo, và lần hỏng thật tiếp
# theo không ai đọc.
CANH_GAC_BAT=true
CANH_GAC_MOI_GIAY=300
# Nơi nhận báo động. Để rỗng thì chỉ ghi vào Nhật ký trên dashboard.
# Trỏ vào một webhook n8n để định tuyến đi Zalo, Telegram, email tuỳ ý.
CANH_GAC_WEBHOOK=
# Khách đã được chuyển cho người mà chờ quá số phút này thì canh gác báo
# động, và ô thời gian chờ trên khung trực đổi màu. Đây là phép kiểm duy
# nhất hướng ra phía KHÁCH — các phép còn lại hỏi "hệ thống có sống không",
# phép này hỏi "có ai đang bị bỏ quên không". Đổi số ở đây thì đổi luôn
# CHO_LAU_PHUT trong dashboard/app.js cho khớp (có test canh việc đó).
CHO_NGUOI_TOI_DA_PHUT=30

# --- Giờ làm việc ---------------------------------------------
# Ngoài giờ, câu báo chuyển người đổi từ "sẽ nhắn lại sớm" sang "sẽ nhắn
# lại từ 8 giờ sáng mai". Lúc 2 giờ sáng chữ "sớm" là một lời hứa không ai
# giữ được, và cả hệ thống này được xây quanh nguyên tắc không phát ngôn
# không có căn cứ. Ngoài giờ, canh gác cũng thôi báo "có khách chờ" — báo
# lúc 2 giờ sáng cho việc không ai làm được tới sáng là cách nhanh nhất
# khiến người ta tắt thông báo.
# Giờ Việt Nam (UTC+7). Khoảng [bat_dau, ket_thuc): 20:59 còn trong giờ.
# Tiệm trực 24/7 thì đặt GIO_LAM_VIEC_BAT=false.
GIO_LAM_VIEC_BAT=true
GIO_LAM_VIEC_BAT_DAU=8
GIO_LAM_VIEC_KET_THUC=21

# --- Xác thực dashboard ---------------------------------------
# BẮT BUỘC bật khi chạy sau HTTPS. Bật khi còn http://localhost thì trình
# duyệt không gửi cookie và không ai đăng nhập được.
COOKIE_BAO_MAT=false
