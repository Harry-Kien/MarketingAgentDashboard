# Cấu hình của cửa hàng «MA» — SINH bởi `python -m scripts.cua_hang tao`.
# Chứa bí mật: không đưa lên git, không gửi qua chat. Sửa tay được; chạy
# `python -m scripts.cua_hang khoi_dong_lai «MA»` để áp.

# --- CSDL riêng của cửa hàng (role thường, không phải superuser) ---
DATABASE_URL=postgresql://ch_«MA»:«MAT_KHAU_DB»@postgres:5432/ch_«MA»

# --- Bí mật sinh ngẫu nhiên cho RIÊNG cửa hàng này ---
CREDENTIAL_MASTER_KEYS=1:«KHOA_VAULT»
WEBHOOK_SECRET=«WEBHOOK_SECRET»
ZALO_SIDECAR_SECRET=«SIDECAR_SECRET»
ZALO_SIDECAR_URL=http://sidecar:3210

# --- Địa chỉ công khai (Caddy cấp TLS tự động) ---
PUBLIC_BASE_URL=https://«TEN_MIEN»
COOKIE_BAO_MAT=true

# --- Mô hình: cửa hàng tự nhập khoá ở dashboard (Cấu hình → Model) ---
LLM_PROVIDER=gemini_api
GEMINI_API_KEY=

# --- Gói cước (agent/goi_cuoc.py) — đổi bằng `cua_hang goi «MA» <gói>` ---
GOI_CUOC=dung_thu
GIOI_HAN_KENH=«GIOI_HAN_KENH»
GIOI_HAN_NHAN_VIEN=«GIOI_HAN_NHAN_VIEN»
GIOI_HAN_HOI_THOAI_AI_THANG=«GIOI_HAN_AI»

# --- Vận hành trong container ---
# Báo cho `scripts.san_sang` biết đang ở container silo: sao lưu và người
# canh do mặt phẳng điều khiển chạy từ ngoài, cấu hình là biến môi trường.
CSKH_SILO=1
VAI_TRO_TIEN_TRINH=tat_ca
# Sao lưu do mặt phẳng điều khiển chạy từ container Postgres
# (`cua_hang sao_luu`), không chạy trong app: image app không có pg_dump.
SAO_LUU_MOI_NGAY=false
LEGACY_POLLING_BAT=false
