# Kien Omnichannel — cấu hình môi trường
# Copy thành .env. Credential từng account được nhập trong dashboard và mã hóa
# trong PostgreSQL; không đặt token kênh trực tiếp ở file này.

# --- Model và Google Cloud ------------------------------------
LLM_PROVIDER=gemini
ANTHROPIC_API_KEY=
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=global
GEMINI_REGION=us-central1
MODEL_CHAT=gemini-2.5-flash
MODEL_HARD=gemini-2.5-pro
MODEL_CHEAP=gemini-2.5-flash-lite

# --- Database và credential vault ----------------------------
DATABASE_URL=postgresql://agent:agent@localhost:5433/marketing_agent
# Sinh AES-256 key riêng cho dev/staging/prod:
# python -c "import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
CREDENTIAL_MASTER_KEYS=
CREDENTIAL_ACTIVE_KEY_VERSION=1

# --- Callback public ------------------------------------------
# Production phải là HTTPS public; dashboard hiển thị callback riêng theo account.
WEBHOOK_PUBLIC_URL=http://host.docker.internal:8000
WEBHOOK_SECRET=
PUBLIC_BASE_URL=http://host.docker.internal:8000

# --- Chế độ agent ---------------------------------------------
AGENT_ENABLED=true
# assist trước, chỉ chuyển auto sau evaluation và canary.
AGENT_MODE=assist
CONFIDENCE_FLOOR=0.55
MAX_COST_PER_CONVERSATION=0.25

# --- Giọng đọc và video ---------------------------------------
TTS_PROVIDER=auto
TTS_BASE_URL=http://localhost:8298/v1
TTS_VOICE=nu-nhe-nhang
GOOGLE_TTS_VOICE=vi-VN-Neural2-A
VIDEO_STUDIO_DIR=./video-studio
VIDEO_OUTPUT_DIR=./data/videos
FFPROBE_BIN=ffprobe
VEO_MODEL=
HYPERFRAMES_BAT=false

# --- Phân phối nội dung ---------------------------------------
N8N_WEBHOOK_URL=
N8N_AUTH_HEADER=
TIKTOK_ACCESS_TOKEN=
TIKTOK_PRIVACY=SELF_ONLY
TU_DONG_DANG_KHONG_CAN_DUYET=false

# --- Trace tùy chọn -------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3001

# --- Canh gác -------------------------------------------------
CANH_GAC_BAT=true
CANH_GAC_MOI_GIAY=300
CANH_GAC_WEBHOOK=
CHO_NGUOI_TOI_DA_PHUT=30

# --- Giờ làm việc ---------------------------------------------
GIO_LAM_VIEC_BAT=true
GIO_LAM_VIEC_BAT_DAU=8
GIO_LAM_VIEC_KET_THUC=21

# --- Tích hợp MCP tùy chọn ------------------------------------
# Để trống là tắt. Khi bật, dùng token ngẫu nhiên ít nhất 32 byte.
MCP_TOKEN=

# --- Xác thực dashboard ---------------------------------------
# Chỉ bật true sau khi hostname đã chạy HTTPS.
COOKIE_BAO_MAT=false

# --- DI SẢN — chỉ bật khi đang migration ----------------------
# Đường nạp tin ZaloCRM cũ. Mặc định TẮT, và cố ý không suy ra từ việc
# `ZALOCRM_API_KEY` có giá trị hay không: `.env` không đi theo repo nên
# khoá cũ còn sót lại là chuyện thường, và điều đó KHÔNG có nghĩa người
# vận hành muốn chạy đường cũ.
#
# Bật đồng thời với connector native là hai đường cùng nạp tin: một khách
# sinh hai hội thoại, và không có gì báo. Xem agent.main.nen_chay_poller_legacy.
LEGACY_POLLING_BAT=false

# --- Vai của tiến trình ---------------------------------------
# "tat_ca" | "api" | "worker"
#
# Mặc định "tat_ca" cho máy lẻ một tiến trình. Khi triển khai nhiều bản
# API (uvicorn --workers N hoặc nhiều container), PHẢI đặt "api" cho chúng
# và dựng ĐÚNG MỘT tiến trình "worker".
#
# Không chia vai thì mỗi bản API tự dựng một bộ vòng nền đầy đủ: N bản
# backup loop chạy pg_dump song song trên cùng CSDL, và bản sao lưu cắt dở
# chỉ lộ ra đúng lúc cần phục hồi. Xem agent.main.nen_chay_vong_nen.
VAI_TRO_TIEN_TRINH=tat_ca

# --- Vận chuyển: GHN ------------------------------------------
# `mock` không gọi mạng, không tốn phí, không tạo vận đơn thật — mặc định an
# toàn. Đổi sang `ghn` là hành động có hậu quả tiền bạc.
SHIPPING_PROVIDER=mock
# Sandbox của GHN. Lên thật thì đổi thành:
#   https://online-gateway.ghn.vn/shiip/public-api/v2
GHN_API_URL=https://dev-online-gateway.ghn.vn/shiip/public-api/v2
# GHN → Quản lý cửa hàng → API Token
GHN_TOKEN=
# GHN → Quản lý cửa hàng → Mã cửa hàng (ShopId)
GHN_SHOP_ID=
# Bí mật nằm trong URL webhook — GHN KHÔNG ký webhook, họ chỉ gọi vào URL ta
# khai. TRỐNG nghĩa là TỪ CHỐI mọi webhook vận chuyển, không phải chấp nhận
# tất cả: đường này cho phép đánh dấu đơn "đã giao" hoặc "hoàn về", mà hoàn
# về sẽ cộng hàng lại vào kho.
#
# Sinh mà không in ra màn hình:
#   python -m scripts.sinh_token SHIPPING_WEBHOOK_SECRET
#
# URL khai với GHN:
#   https://<tên miền>/webhook/shipping/ghn?token=<giá trị dòng dưới>
SHIPPING_WEBHOOK_SECRET=

# --- Zalo cá nhân: sidecar Node ------------------------------
# Bí mật ký HMAC hai chiều giữa app và sidecar. Hai bên phải TRÙNG NHAU.
# Đặt ở đây là XONG: máy chủ tự điền vào tài khoản Zalo cá nhân khi tạo.
# Người nối kênh chỉ đặt tên rồi quét QR, không nhập bí mật nào.
#
# Sinh mà không in ra màn hình:
#   python -m scripts.sinh_token ZALO_SIDECAR_SECRET
ZALO_SIDECAR_SECRET=
# Địa chỉ app gọi sang sidecar. Máy chủ TỰ ĐIỀN giá trị này vào tài khoản
# Zalo cá nhân — người dùng không phải nhập gì khi nối kênh.
# Đổi khi sidecar chạy ở container hoặc máy khác.
ZALO_SIDECAR_URL=http://127.0.0.1:3210
# Sidecar gọi ngược về control plane theo địa chỉ này.
# PHẢI là URL ĐẦY ĐỦ tới router, không phải chỉ host: sidecar dựng đích bằng
# `<url>/<account_id>`, nên thiếu đường dẫn là mọi callback rơi vào 404 —
# phiên sau khi quét QR không tới nơi, tài khoản kẹt ở `pending:`, tin khách
# nhắn vào biến mất, và không có dòng lỗi nào ở đâu cả.
# Canh bằng tests/test_sidecar_callback_url.py
ZALO_CONTROL_PLANE_URL=http://127.0.0.1:8000/webhook/native/zalo-personal

# Nhịp hỏi CSDL của luồng realtime trên dashboard (giây).
# Đây là độ trễ người trực cảm nhận khi tin mới tới. Nới lên chỉ khi có rất
# nhiều người trực cùng mở dashboard.
SSE_POLL_SECONDS=0.25

# --- Nơi nhận báo động ----------------------------------------
# Địa chỉ webhook nhận báo động khi hệ thống hỏng hoặc sống lại.
#
# TELEGRAM (đơn giản nhất, miễn phí, báo thẳng vào điện thoại):
#   1. Nhắn @BotFather trên Telegram -> /newbot -> lấy TOKEN
#   2. Nhắn một câu cho bot vừa tạo
#   3. Mở https://api.telegram.org/bot<TOKEN>/getUpdates -> lấy chat id
#   4. Điền hai dòng dưới:
# CANH_GAC_WEBHOOK=https://api.telegram.org/bot<TOKEN>/sendMessage
# CANH_GAC_GOI_TIN={"chat_id":"<chat id>","text":"[{muc_do}] {tieu_de} — {chi_tiet}"}
#
# Để trống CANH_GAC_GOI_TIN thì gửi dạng mặc định — hợp với n8n, Slack
# workflow, hoặc endpoint tự viết.
CANH_GAC_WEBHOOK=
CANH_GAC_GOI_TIN=

# --- Meta OAuth: nối Trang bằng ĐĂNG NHẬP ---------------------
# Thông tin của ỨNG DỤNG Meta, KHÁC token của từng Trang.
# Lấy ở: developers.facebook.com/apps -> App settings -> Basic
#
# Có hai giá trị này thì trên dashboard hiện nút "Kết nối Facebook /
# Instagram bằng đăng nhập": bấm một lần, chọn Trang, hệ thống tự nhận
# token cho TẤT CẢ Trang đã chọn. Không phải dán tay từng Trang.
#
# Cần PUBLIC_BASE_URL là HTTPS, và phải khai địa chỉ quay về trong
# Meta App -> Facebook Login -> Settings -> Valid OAuth Redirect URIs:
#   <PUBLIC_BASE_URL>/api/connect/meta/callback
META_APP_ID=
META_APP_SECRET=

# --- Kho / ERP ---
# tep = đọc data/catalog.json (mặc định, chạy được ngay sau khi clone)
ERP_LOAI=tep
# Tuổi thọ số liệu (giây). Quá hạn mà gọi ERP hỏng thì cổng nói "không biết"
# chứ KHÔNG trả số cũ.
ERP_TTL_GIA=900
ERP_TTL_TON=60
ERP_NGAT_MACH_SO_LAN=5
ERP_NGAT_MACH_GIAY=30
# Hạn cho ĐƯỜNG TRẢ LỜI KHÁCH và số lần thử lại khi ERP nấc một nhịp.
# Chỉ áp cho thao tác ĐỌC — ghi đơn không đi qua đây.
ERP_HAN_CHO_GIAY=4
ERP_SO_LAN_THU=2

# Bắt buộc khi ERP_LOAI khác "tep" — adapter NÉM ngay lúc khởi động nếu
# thiếu, chứ không lặng lẽ cộng tồn của mọi kho lại thành một con số sai.
ERP_MA_KHO=
ERP_PRICELIST=

# --- ERPNext (khi ERP_LOAI=erpnext) ---
# Sinh khoá trong ERPNext: User > API Access > Generate Keys
ERPNEXT_URL=
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=

# --- Odoo (khi ERP_LOAI=odoo) ---
# API key sinh trong Odoo: Preferences > Account Security > New API Key.
# ERP_MA_KHO ở đây nhận mã kho (stock.warehouse.code) hoặc id dạng số.
ODOO_URL=
ODOO_DB=
ODOO_DANG_NHAP=
ODOO_API_KEY=

# Đẩy đơn agent chốt sang ERP. MẶC ĐỊNH TẮT — bật lên tạo dữ liệu KHÔNG XOÁ
# ĐƯỢC trong ERP của cửa hàng. Chạy `python -m scripts.thu_erp` cho xanh
# trước đã.
ERP_GHI_DON=false
