# ============================================================
#  Marketing Agent — cấu hình
#  Copy sang .env rồi điền. KHÔNG commit .env.
# ============================================================

# --- Nhà cung cấp model ---------------------------------------
# vertex    : Claude qua Vertex AI. Cần project ĐÃ ĐƯỢC CẤP QUOTA Claude.
#             Project mới mặc định quota = 0 -> mọi lời gọi trả 429.
# anthropic : Claude qua API trực tiếp. Chỉ cần API key, chạy được ngay.
# Cùng model, cùng giá. Đổi dòng này là đổi đường đi, không sửa mã.
LLM_PROVIDER=vertex
ANTHROPIC_API_KEY=

# --- Google Cloud / Vertex AI ---------------------------------
# Xác thực: chạy `gcloud auth application-default login` trước.
# LƯU Ý: embedding cho RAG luôn dùng Vertex (hạn mức riêng, độc lập
# với quota Claude), nên GCP_PROJECT_ID vẫn cần dù chọn provider nào.
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=global

# Model trên Vertex dùng ID TRẦN, không prefix.
MODEL_CHAT=claude-sonnet-5
MODEL_HARD=claude-opus-5
MODEL_CHEAP=claude-haiku-4-5

# --- ZaloCRM (kênh giai đoạn 1) -------------------------------
# Lấy X-API-Key trong Settings của ZaloCRM sau khi quét QR.
ZALOCRM_BASE_URL=http://localhost:3000
ZALOCRM_API_KEY=
# Webhook ZaloCRM gọi về đây. Trong Docker Desktop trên Windows
# phải dùng host.docker.internal, không dùng localhost.
WEBHOOK_PUBLIC_URL=http://host.docker.internal:8000/webhook
WEBHOOK_SECRET=doi-chuoi-nay-di

# --- Cơ sở dữ liệu --------------------------------------------
DATABASE_URL=postgresql://agent:agent@localhost:5433/marketing_agent

# --- Giọng đọc (viet-tts) -------------------------------------
TTS_BASE_URL=http://localhost:8298/v1
TTS_VOICE=nu-nhe-nhang

# --- Video ----------------------------------------------------
VIDEO_STUDIO_DIR=./video-studio
VIDEO_OUTPUT_DIR=./data/videos
FFPROBE_BIN=ffprobe
# Bậc dựng hình cao nhất (ảnh sản phẩm -> cảnh quay có chuyển động).
# ĐỂ RỖNG LÀ TẮT — Veo tính tiền theo giây video sinh ra, không nên để nó
# tự chạy. Bật bằng cách điền tên model, ví dụ: veo-3.1-generate-preview
# Cần xin quota Veo trên GCP trước.
VEO_MODEL=

# --- Langfuse (trace + chi phí) -------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3001

# --- Vận hành -------------------------------------------------
# Bật/tắt agent tức thì. false = mọi tin nhắn chuyển thẳng cho người.
AGENT_ENABLED=true
# assist  = agent chỉ gợi ý, người bấm gửi (khuyến nghị khi mới chạy)
# auto    = agent tự trả lời
AGENT_MODE=assist
# Ngưỡng tin cậy dưới mức này thì chuyển người.
CONFIDENCE_FLOOR=0.55
# Trần chi phí mỗi hội thoại (USD). Vượt thì chuyển người.
MAX_COST_PER_CONVERSATION=0.25
