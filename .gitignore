.env
.venv/
__pycache__/
*.pyc
.DS_Store

# --- Bên thứ ba ---
# ZaloCRM giờ là SUBMODULE, ghim đúng commit đang dùng — xem .gitmodules.
# Submodule là một CON TRỎ tới repo của họ, không phải bản chép. Nhờ vậy:
#   - clone kèm --recurse-submodules là có đủ để chạy
#   - mã AGPL vẫn nằm trong repo của họ, dưới giấy phép của họ, nên nghĩa
#     vụ copyleft không lan sang mã nguồn này
# Chép thẳng mã vào đây thì gộp hai thứ làm một, và AGPL Điều 13 buộc công
# bố toàn bộ mã nguồn hệ thống cho bất kỳ ai dùng nó qua mạng.
video-studio/

# --- Dữ liệu doanh nghiệp: KHÔNG đẩy lên repo công khai ---
# Tài liệu công ty, bảng giá, tồn kho, bộ eval và kết quả chạy đều là dữ
# liệu vận hành, không phải mã nguồn. Repo này công khai.
data/knowledge/
data/eval/
data/test_img/
data/videos/

# Danh mục THẬT không lên repo. Bản mẫu `catalog.example.json` thì CÓ, để
# máy vừa clone về chạy được ngay — mã tự dùng bản mẫu khi chưa có bản thật.
data/catalog.json

# Ảnh mẫu tổng hợp (do script sinh ra) thì GIỮ LẠI — lệnh test trong README
# cần chúng, và chúng không chứa thông tin thật nào.
!data/mau/
.env.chatwoot

# Log của server chạy nền
data/uvicorn.log
data/uvicorn.log.err

# Ban sao luu: chua du lieu that, KHONG len repo cong khai
data/backup/

# Trạng thái người canh bên ngoài — dữ liệu chạy, không phải mã.
data/.canh_gac_ngoai
