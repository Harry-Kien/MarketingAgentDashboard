# Chặn CẢ HỌ .env, không liệt kê từng biến thể.
#
# Trước đây chỗ này liệt kê `.env`, `.env.bak`, `.env.*.bak`, `.env.env.bak`
# — và vẫn để lọt. Một script sao lưu dùng `Path(".env").with_suffix()`, hàm
# đó NỐI THÊM đuôi chứ không thay, sinh ra `.env.env.truoc-credential-key`.
# Tên ấy không khớp mẫu nào, nên git nhìn thấy một bản sao đầy đủ của .env
# — có bí mật — ở dạng untracked.
#
# Đoán trước từng biến thể là trò đuổi bắt không bao giờ thắng. Chặn cả họ,
# rồi mở ngoại lệ cho đúng những bản mẫu PHẢI đi theo repo.
.env*
!.env.example
!.env.chatwoot.example
.venv/
__pycache__/
*.pyc
.DS_Store

# --- Bên thứ ba ---
# ZaloCRM giờ là SUBMODULE, ghim đúng commit đang dùng — xem .gitmodules.
# Submodule là một CON TRỎ tới repo của họ, không phải bản chép. Nhờ vậy:
#   - clone kèm --recurse-submodules là có đủ để chạy
#   - mã AGPL vẫn nằm trong repo của họ, dưới giấy phép của họ, nên nghĩa
#     vụ copyleft không lan sang mã nguồn này
# Chép thẳng mã vào đây thì gộp hai thứ làm một, và AGPL Điều 13 buộc công
# bố toàn bộ mã nguồn hệ thống cho bất kỳ ai dùng nó qua mạng.
video-studio/

# --- Dữ liệu doanh nghiệp: KHÔNG đẩy lên repo công khai ---
# Tài liệu công ty, bảng giá, tồn kho, bộ eval và kết quả chạy đều là dữ
# liệu vận hành, không phải mã nguồn. Repo này công khai.
data/knowledge/
# Và mọi thư mục lưu trữ tài liệu cũ. Chúng là bản sao của kho tri thức —
# cùng nội dung, cùng lý do không lên repo. Chặn kho gốc mà để lọt bản lưu
# trữ của nó là chặn một nửa, y như chuyện đã xảy ra với catalog.json.bak.
data/knowledge.*/
# NGOẠI TRỪ bản mẫu: CI có job chạy trên bản clone sạch, và job đó cần
# `knowledge.example` để agent có tài liệu mà trả lời. Chặn nhầm nó là CI
# đỏ trên mọi máy vừa clone, với lý do rất khó đoán.
!data/knowledge.example/
data/eval/*
# Ngoại lệ: bộ kịch bản MẪU là hiện vật kiểm thử, không phải dữ liệu doanh
# nghiệp — hội thoại hư cấu, thương hiệu hư cấu, không có số liệu thật nào.
# Nó PHẢI lên repo, vì tests/test_eval_nhieu_luot.py đọc nó: máy vừa clone
# mà thiếu file này thì CI đỏ ngay ở bước thu thập.
!data/eval/kich_ban.example.jsonl
data/test_img/
data/videos/

# Danh mục THẬT không lên repo. Bản mẫu `catalog.example.json` thì CÓ, để
# máy vừa clone về chạy được ngay — mã tự dùng bản mẫu khi chưa có bản thật.
data/catalog.json
# Và bản sao lưu của nó. `scripts/nap_catalog_tu_excel.py` tạo tệp này mỗi
# lần ghi đè danh mục — nó chứa ĐÚNG những con số mà dòng trên đang chặn.
# Chặn danh mục mà để lọt bản sao của chính nó là chặn một nửa.
data/catalog.json.bak
# Ánh xạ mã là cấu hình của TỪNG cửa hàng. Bản `.example` đi theo repo để
# người cài biết định dạng; bản thật thì không, để mã của cửa hàng này không
# theo clone sang cửa hàng khác.
data/anh_xa_ma.json

# Ảnh mẫu tổng hợp (do script sinh ra) thì GIỮ LẠI — lệnh test trong README
# cần chúng, và chúng không chứa thông tin thật nào.
!data/mau/

# Log của server chạy nền
data/uvicorn.log
data/uvicorn.log.err

# Ban sao luu: chua du lieu that, KHONG len repo cong khai
data/backup/

# Trạng thái người canh bên ngoài — dữ liệu chạy, không phải mã.
data/.canh_gac_ngoai

# --- Thư mục sinh ra khi chạy, KHÔNG bao giờ vào repo ---
# node_modules của sidecar có hàng nghìn file. Lỡ commit một lần là lịch sử
# repo phình vĩnh viễn: git không quên được, và `git rm` sau đó chỉ thêm một
# commit nữa chứ không xoá được quá khứ.
node_modules/
.playwright-cli/
output/
.ruff_cache/

# Verify token đọc ra từ vault để dán vào Meta. Đọc xong nên xoá.
data/verify-token.txt

# Bộ nhớ làm việc của công cụ Serena — trạng thái máy, không phải mã nguồn.
.serena/

# Log của tunnel — trạng thái chạy, đổi mỗi lần khởi động.
data/tunnel.log

# Log sidecar Zalo — trạng thái chạy, không phải mã nguồn.
data/sidecar.log

# Ảnh và tài liệu nhân viên gửi cho khách — dữ liệu vận hành, không phải mã.
data/uploads/
